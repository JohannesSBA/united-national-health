// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  name                String
  emailVerified       Boolean        @default(false)
  image               String?
  status              UserStatus     @default(ACTIVE)
  roles               UserRole[]
  hospitalMemberships HospitalUser[]
  accounts            Account[]
  sessions            Session[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  assignments UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Hospital {
  id        String         @id @default(uuid())
  name      String         @unique
  code      String?        @unique
  region    String?
  contactEmail String?
  contactPhone String?
  description String?
  status    HospitalStatus @default(PENDING)
  members   HospitalUser[]
  onboardingActions OnboardingAction[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model HospitalUser {
  id         String   @id @default(uuid())
  userId     String
  hospitalId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, hospitalId])
  @@index([userId])
  @@index([hospitalId])
}

model Account {
  id                    String    @id @default(uuid())
  providerId            String
  accountId             String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(uuid())
  value      String
  identifier String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  key         String @id
  count       Int
  lastRequest Float
}

enum HospitalStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

enum OnboardingPriority {
  LOW
  MEDIUM
  HIGH
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum SystemStatusState {
  OPERATIONAL
  DEGRADED
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
}

enum ActivityCategory {
  GOVERNANCE
  SECURITY
  ACCESS
  SYSTEM
}

enum CrossAccessPolicyStatus {
  DRAFT
  ACTIVE
  REVOKED
}

model OnboardingAction {
  id        String            @id @default(uuid())
  hospitalId String
  action    String
  owner     String
  dueDate   DateTime
  priority  OnboardingPriority
  status    OnboardingStatus   @default(PENDING)
  hospital  Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([hospitalId])
  @@index([status])
}

model AdminActivity {
  id        String   @id @default(uuid())
  actor     String
  action    String
  scope     String
  category  ActivityCategory @default(GOVERNANCE)
  createdAt DateTime @default(now())
}

model SystemStatus {
  id              String             @id @default(uuid())
  overallStatus   SystemStatusState
  uptimePercent   Float
  lastIncidentAt  DateTime?
  deploymentVersion String
  createdAt       DateTime           @default(now())
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationKey {
  id            String            @id @default(uuid())
  name          String
  description   String?
  tokenHash     String
  lastFour      String?
  status        IntegrationStatus @default(ACTIVE)
  lastRotatedAt DateTime?
  createdBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model AccessPolicy {
  id            String                  @id @default(uuid())
  name          String
  description   String?
  hospitalScope String[]
  status        CrossAccessPolicyStatus @default(DRAFT)
  approvedBy    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model SecurityAlert {
  id             String   @id @default(uuid())
  type           String
  severity       String
  description    String
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  acknowledgedBy String?
}

model RolePolicy {
  id          String   @id @default(uuid())
  roleName    String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
