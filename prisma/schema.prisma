// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  name                String
  emailVerified       Boolean        @default(false)
  image               String?
  status              UserStatus     @default(ACTIVE)
  roles               UserRole[]
  hospitalMemberships HospitalUser[]
  staffProfiles       StaffMember[]
  auditLogs           AuditLog[]
  accounts            Account[]
  sessions            Session[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  assignments UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Hospital {
  id                String                 @id @default(uuid())
  name              String                 @unique
  code              String?                @unique
  region            String?
  contactEmail      String?
  contactPhone      String?
  description       String?
  status            HospitalStatus         @default(PENDING)
  members           HospitalUser[]
  onboardingActions OnboardingAction[]
  staff             StaffMember[]
  departments       Department[]
  rooms             Room[]
  equipment         Equipment[]
  schedules         Schedule[]
  inventoryItems    InventoryItem[]
  staffAssignments  StaffAssignment[]
  auditLogs         AuditLog[]
  patientFlow       PatientFlowSnapshot[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([contactEmail])
  @@unique([contactPhone])
}

model HospitalUser {
  id         String   @id @default(uuid())
  userId     String
  hospitalId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, hospitalId])
  @@index([userId])
  @@index([hospitalId])
}

model Account {
  id                    String    @id @default(uuid())
  providerId            String
  accountId             String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String   @id @default(uuid())
  value      String
  identifier String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  key         String @id
  count       Int
  lastRequest Float
}

enum HospitalStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DECOMMISSIONED
}

enum OnboardingPriority {
  LOW
  MEDIUM
  HIGH
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum SystemStatusState {
  OPERATIONAL
  DEGRADED
  MAINTENANCE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IntegrationStatus {
  ACTIVE
  DISABLED
}

enum ActivityCategory {
  GOVERNANCE
  SECURITY
  ACCESS
  SYSTEM
}

enum CrossAccessPolicyStatus {
  DRAFT
  ACTIVE
  REVOKED
}

enum StaffRole {
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  PHARMACIST
  ADMINISTRATIVE
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum RoomType {
  WARD
  ICU
  OPERATING_THEATER
  LAB
  PHARMACY
  ADMINISTRATION
  OTHER
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum ScheduleType {
  DOCTOR_SHIFT
  NURSE_SHIFT
  ON_CALL
  SURGERY
}

enum ScheduleStatus {
  DRAFT
  CONFIRMED
  CANCELED
}

enum InventoryStatus {
  NORMAL
  LOW_STOCK
  OUT_OF_STOCK
  ORDERED
}

model OnboardingAction {
  id        String            @id @default(uuid())
  hospitalId String
  action    String
  owner     String
  dueDate   DateTime
  priority  OnboardingPriority
  status    OnboardingStatus   @default(PENDING)
  hospital  Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([hospitalId])
  @@index([status])
}

model StaffMember {
  id             String       @id @default(uuid())
  userId         String
  hospitalId     String
  role           StaffRole
  phone          String?
  specialization String?
  licenseNumber  String?
  department     String?
  level          String?
  status         StaffStatus  @default(ACTIVE)
  deletedAt      DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital       Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  assignments    StaffAssignment[]
  headedDepartments Department[] @relation("DepartmentHead")
  schedules      Schedule[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([hospitalId, userId])
  @@index([hospitalId, role])
  @@index([status])
}

model Department {
  id          String           @id @default(uuid())
  hospitalId  String
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)
  headStaffId String?
  deletedAt   DateTime?
  hospital    Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  head        StaffMember?     @relation("DepartmentHead", fields: [headStaffId], references: [id])
  assignments StaffAssignment[]
  schedules   Schedule[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId, status])
}

model StaffAssignment {
  id           String      @id @default(uuid())
  staffId      String
  departmentId String
  hospitalId   String
  role         StaffRole
  isLead       Boolean     @default(false)
  startsAt     DateTime
  endsAt       DateTime?
  notes        String?
  staff        StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  hospital     Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([staffId])
  @@index([departmentId])
  @@index([hospitalId])
  @@index([isLead])
}

model Room {
  id           String     @id @default(uuid())
  hospitalId   String
  name         String
  code         String?
  type         RoomType
  capacity     Int        @default(1)
  occupiedBeds Int        @default(0)
  status       RoomStatus @default(ACTIVE)
  notes        String?
  deletedAt    DateTime?
  hospital     Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  equipment    Equipment[]
  schedules    Schedule[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId, status])
}

model Equipment {
  id           String          @id @default(uuid())
  hospitalId   String
  roomId       String?
  name         String
  type         String
  serialNumber String?
  status       EquipmentStatus @default(AVAILABLE)
  notes        String?
  deletedAt    DateTime?
  hospital     Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  room         Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([hospitalId])
  @@index([roomId])
  @@index([status])
}

model Schedule {
  id           String         @id @default(uuid())
  hospitalId   String
  staffId      String?
  departmentId String?
  roomId       String?
  title        String
  scheduleType ScheduleType
  startsAt     DateTime
  endsAt       DateTime
  status       ScheduleStatus @default(CONFIRMED)
  metadata     Json?
  createdBy    String
  deletedAt    DateTime?
  hospital     Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  staff        StaffMember?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  room         Room?          @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([hospitalId, scheduleType])
  @@index([staffId])
  @@index([departmentId])
  @@index([roomId])
  @@index([startsAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  hospitalId   String
  actorId      String
  action       String
  resourceType String
  resourceId   String?
  changes      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  hospital     Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  actor        User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([actorId])
  @@index([resourceType])
  @@index([createdAt])
}

model InventoryItem {
  id         String          @id @default(uuid())
  hospitalId String
  name       String
  category   String?
  quantity   Int             @default(0)
  unit       String?
  threshold  Int             @default(0)
  status     InventoryStatus @default(NORMAL)
  deletedAt  DateTime?
  hospital   Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([hospitalId])
  @@index([status])
}

model PatientFlowSnapshot {
  id                  String   @id @default(uuid())
  hospitalId          String
  recordedFor         DateTime
  patientCount        Int
  admissions          Int
  discharges          Int
  bedOccupancyPercent Float
  avgWaitMinutes      Int?
  hospital            Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([hospitalId, recordedFor])
  @@index([recordedFor])
}

model AdminActivity {
  id        String   @id @default(uuid())
  actor     String
  action    String
  scope     String
  category  ActivityCategory @default(GOVERNANCE)
  metadata  Json?
  createdAt DateTime @default(now())
}

model SystemStatus {
  id              String             @id @default(uuid())
  overallStatus   SystemStatusState
  uptimePercent   Float
  lastIncidentAt  DateTime?
  deploymentVersion String
  createdAt       DateTime           @default(now())
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IntegrationKey {
  id            String            @id @default(uuid())
  name          String
  description   String?
  tokenHash     String
  lastFour      String?
  status        IntegrationStatus @default(ACTIVE)
  lastRotatedAt DateTime?
  createdBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model AccessPolicy {
  id            String                  @id @default(uuid())
  name          String
  description   String?
  hospitalScope String[]
  status        CrossAccessPolicyStatus @default(DRAFT)
  approvedBy    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model SecurityAlert {
  id             String   @id @default(uuid())
  type           String
  severity       String
  description    String
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?
  acknowledgedBy String?
}

model RolePolicy {
  id          String   @id @default(uuid())
  roleName    String   @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id             String   @id @default(uuid())
  to             String
  subject        String
  bodyCiphertext String   @map("bodyHtml")
  metadata       Json?
  createdAt      DateTime @default(now())
}
