# syntax=docker/dockerfile:1
FROM postgres:16-alpine

LABEL org.opencontainers.image.title="United National Health database" \
  org.opencontainers.image.description="PostgreSQL instance for the United National Health app" \
  org.opencontainers.image.source="https://localhost/united-national-health" \
  org.opencontainers.image.licenses="UNLICENSED"

ARG DB_NAME=united_national_health
ARG DB_USER=unh_app
ARG DB_PASSWORD=unh_local_password
ARG DB_PORT=5432

ENV POSTGRES_DB=${DB_NAME} \
    POSTGRES_USER=${DB_USER} \
    POSTGRES_PASSWORD=${DB_PASSWORD} \
    PGPORT=${DB_PORT} \
    PGDATA=/var/lib/postgresql/data/pgdata

# Ensure the PGDATA directory exists with the expected permissions.
RUN mkdir -p "$PGDATA" && chown -R postgres:postgres "$PGDATA"

# Prisma migrations are applied from the app container/host after startup.

EXPOSE 5432

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 \
  CMD ["sh", "-c", "pg_isready -d \"$POSTGRES_DB\" -U \"$POSTGRES_USER\""]
